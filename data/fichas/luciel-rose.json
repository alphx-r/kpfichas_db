 mãe que não sou um erro ou falhar e mostrar para ela que ela estava certa, mas só vai acontecer no momento que eu desistir de vez e esse é só o começo da minha história…","ocupacao":"Estudante de Gastronomia","box_mini":"1","box_up":"1","inventario":[{"nome":"Pokétch (Rosa)","qtd":1,"bag":"item"},{"nome":"Ultra Ball","qtd":"4","bag":"item"},{"nome":"Moon Ball","qtd":1,"bag":"item"},{"nome":"Heavy Ball","qtd":1,"bag":"item"},{"nome":"Dive Ball","qtd":"3","bag":"item"},{"nome":"Dusk Stone","qtd":1,"bag":"item"},{"nome":"Plume Stone","qtd":1,"bag":"item"},{"nome":"Shiny Stone","qtd":"2","bag":"item"},{"nome":"Water Stone","qtd":"3","bag":"item"},{"nome":"Dawn Stone","qtd":1,"bag":"item"},{"nome":"Thunder Stone","qtd":1,"bag":"item"},{"nome":"Mystic Water","qtd":"2","bag":"item"},{"nome":"Ground Gem","qtd":1,"bag":"item"},{"nome":"Ability Capsule","qtd":1,"bag":"item"},{"nome":"Ability Patch","qtd":1,"bag":"item"},{"nome":"Bioskill Key","qtd":1,"bag":"item"},{"nome":"Incubator","qtd":1,"bag":"item"},{"nome":"Super Rod","qtd":1,"bag":"item"},{"nome":"Honey","qtd":"3","bag":"snack"},{"nome":"Lum Berry","qtd":"3","bag":"forage"},{"nome":"Aguav Berry","qtd":1,"bag":"forage"},{"nome":"TM188: Scald","qtd":1,"bag":"tm"},{"nome":"TM077: Waterfall","qtd":1,"bag":"tm"},{"nome":"Tera Shard","qtd":"5","bag":"alpha","kind":""},{"nome":"Damp Rock","qtd":1,"bag":"item"},{"nome":"Fire Stone","qtd":1,"bag":"item"},{"nome":"Claw Fossil","qtd":1,"bag":"item"},{"nome":"TM Voucher","qtd":1,"bag":"item"},{"nome":"Discount Coupon","qtd":1,"bag":"item","desconto":25}]},"atualizado_em":"2026-11-10T17:41:42.688Z"}