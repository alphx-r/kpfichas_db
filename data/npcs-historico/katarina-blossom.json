\":\"\",\"item\":\"\",\"happ\":\"\",\"stats\":{\"hp\":\"70\",\"atk\":\"60\",\"def\":\"75\",\"satk\":\"110\",\"sdef\":\"75\",\"spd\":\"90\"},\"ath\":{},\"moves\":[],\"moveset\":\"\",\"combo\":\"\"},{},{},{},{},{}]","editado_por":"Ricky","editado_em":"2026-11-28T03:56:14.623Z"},{"campo":"time","valor_anterior":"[{},{},{},{},{},{}]","valor_novo":"[{\"nome\":\"lill\",\"apelido\":\"\",\"ball\":\"pokeball\",\"tipos\":[],\"img\":\"\",\"level\":\"\",\"ability\":\"\",\"gender\":\"male\",\"feature\":\"Normal\",\"nature\":\"\",\"item\":\"\",\"happ\":\"\",\"stats\":null,\"ath\":{},\"moves\":[],\"moveset\":\"\",\"combo\":\"\"},{},{},{},{},{}]","editado_por":"Ricky","editado_em":"2026-11-28T03:56:09.201Z"},{"campo":"relacionamentos","valor_anterior":"[{\"nome\":\"\",\"tipo\":\"\"},{\"nome\":\"\",\"tipo\":\"\"},{\"nome\":\"\",\"tipo\":\"\"},{\"nome\":\"\",\"tipo\":\"\"},{\"nome\":\"\",\"tipo\":\"\"},{\"nome\":\"\",\"tipo\":\"\"}]","valor_novo":"[{\"nome\":\"\",\"tipo\":\"\"}]","editado_por":"Ricky","editado_em":"2026-11-28T03:55:49.185Z"},{"campo":"biografia","valor_anterior":"","valor_novo":"Nascida e criada em Flowrest, Katarina Blossom cresceu cercada por uma das maiores riquezas naturais de Nendo. Desde a infância, demonstrou fascínio pela diversidade vegetal da região, passando horas explorando jardins, observando árvores centenárias e catalogando flores que encontrava pelo caminho. A grandiosa biblioteca da cidade também teve papel fundamental em sua formação, oferecendo acesso a registros botânicos antigos e estudos sobre espécies vegetais de diferentes localidades.<br><br>Com o passar dos anos, seu interesse se transformou em uma dedicação acadêmica à botânica. Katarina aprofundou seus estudos na identificação, classificação e cultivo de plantas, desenvolvendo especial interesse pelas propriedades de espécies raras, pelas condições necessárias ao seu desenvolvimento e pela preservação da flora. Sua curiosidade também a levou a investigar as particularidades das árvores centenárias de Flowrest, especialmente diante das antigas lendas que cercam sua longevidade.<br><br><br>Após concluir sua formação, Katarina encontrou na Ambrosia Academy a oportunidade de compartilhar sua paixão pela botânica com novas gerações. Atualmente, integra o Departamento de Botânica, sendo responsável por introduzir os estudantes ao estudo das plantas, abordando conceitos fundamentais de identificação, classificação, estrutura, desenvolvimento e cultivo de espécies vegetais. Suas aulas buscam despertar a curiosidade individual e apresentar a importância da flora para a manutenção dos ecossistemas e para a vida cotidiana.<br>","editado_por":"Ricky","editado_em":"2026-11-28T03:55:30.111Z"},{"campo":"nome","valor_anterior":"","valor_novo":"NPC criado","editado_por":"Ricky","editado_em":"2026-11-28T00:38:31.654Z"}]